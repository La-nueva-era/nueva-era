---
// Thumbnail facade: no iframe and no YouTube script until the
// reader clicks; then the youtube-nocookie.com player replaces it.
import { Play } from "@lucide/astro";
import Icon from "./Icon.astro";
import { es } from "../i18n/es.ts";

interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
// Some videos have no maxresdefault; YouTube then answers with a 120px grey
// placeholder (or an error). Fall back to hqdefault, which always exists.
const fallback = `if(this.naturalWidth<=120&&this.srcset){this.removeAttribute("srcset");this.src="https://i.ytimg.com/vi/${id}/hqdefault.jpg"}`;
---

<figure class="video" data-video={id} data-title={title}>
  <img
    class="thumb"
    src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
    srcset={`https://i.ytimg.com/vi/${id}/hqdefault.jpg 480w, https://i.ytimg.com/vi/${id}/maxresdefault.jpg 1280w`}
    sizes="(max-width: 640px) 100vw, 64ch"
    alt=""
    width="480"
    height="360"
    fetchpriority="high"
    onload={fallback}
    onerror={fallback}
  />
  <button class="go" type="button" aria-label={es.work.play(title)}>
    <span class="disc">
      <Icon icon={Play} size={26} />
    </span>
  </button>
</figure>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>(
    "figure[data-video]",
  )) {
    fig.querySelector(".go")?.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${fig.dataset.video}?autoplay=1`;
      iframe.title = fig.dataset.title ?? "";
      iframe.allow = "autoplay; encrypted-media; picture-in-picture";
      iframe.allowFullscreen = true;
      fig.replaceChildren(iframe);
      iframe.focus();
    });
  }
</script>

<style>
  .video {
    margin: var(--s-8) 0 0 var(--indent);
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--r);
    overflow: hidden;
    background: var(--raise);
  }
  .video .thumb,
  .video .go,
  .video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video .thumb {
    object-fit: cover;
    filter: grayscale(0.25) brightness(0.82);
    transition: filter var(--t-slow);
  }
  .video:hover .thumb {
    filter: grayscale(0) brightness(0.92);
  }
  .video .go {
    display: grid;
    place-items: center;
  }
  .video .disc {
    display: grid;
    place-items: center;
    width: var(--s-16);
    height: var(--s-16);
    border: 1.5px solid var(--on-video);
    border-radius: 50%;
    background: var(--video-scrim);
    color: var(--on-video);
    opacity: 0.9;
    transition:
      transform var(--t-slow) ease,
      opacity var(--t-slow);
  }
  /* Filled glyph, nudged right so the triangle reads as centred. */
  .video .disc :global(svg) {
    fill: currentColor;
    margin-left: 3px;
  }
  .video .go:hover .disc {
    transform: scale(1.06);
    opacity: 1;
  }
</style>
