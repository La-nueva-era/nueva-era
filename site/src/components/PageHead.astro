---
interface Props {
  title: string;
  lead?: string | undefined;
}
const { title, lead } = Astro.props;
---

<div class="pagehead indented">
  <div class="title">
    <h1>{title}</h1>
    <slot name="title-aside" />
  </div>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</div>

<style>
  .pagehead {
    margin: var(--s-14) 0 var(--s-10);
  }
  .title {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  /* The title's descenders pull its line box's centre below the letters;
     move the aside down to the middle of the lowercase text. */
  .title > :global(:not(h1)) {
    translate: 0 0.3rem;
  }
  h1 {
    font-size: var(--fs-h1);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .lead {
    margin: var(--s-2) 0 0;
    font-size: var(--fs-lead);
    color: var(--muted);
  }
</style>
