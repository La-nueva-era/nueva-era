---
// Global header (SPEC §7.1): wordmark, and quiet links to the sections that
// exist. The search field arrives with the search index (Phase 2).
import { es } from "../i18n/es.ts";
import { loadEdition } from "../lib/edition.ts";

const { authors } = await loadEdition();
const path = Astro.url.pathname;
---

<header class="site indented">
  <a class="wordmark" href="/">
    {es.site.name}
  </a>
  <nav aria-label={es.nav.label}>
    {authors.map((a) => (
      <a
        href={`/${a.id}`}
        aria-current={path === `/${a.id}` ? "page" : undefined}
      >
        {a.name}
      </a>
    ))}
  </nav>
</header>

<style>
  header.site {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-top: var(--s-5);
  }
  .wordmark {
    font-size: 0.92rem;
    font-weight: 500;
    font-variant: small-caps;
    letter-spacing: 0.09em;
    text-decoration: none;
    white-space: nowrap;
  }
  .wordmark:hover {
    text-decoration: underline;
    text-decoration-color: var(--faint);
  }
  nav {
    display: flex;
    gap: var(--s-4);
    font-size: var(--fs-ui);
    color: var(--muted);
    white-space: nowrap;
  }
  nav a {
    text-decoration: none;
    transition: color var(--t);
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
  }
</style>
