---
import { es } from "../i18n/es.ts";
---

<header class="site indented">
  <a class="wordmark" href="/">
    {es.site.name}
  </a>
</header>

<style>
  header.site {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding-top: var(--s-5);
  }
  .wordmark {
    font-size: 0.92rem;
    font-weight: 500;
    font-variant: small-caps;
    letter-spacing: 0.09em;
    text-decoration: none;
    white-space: nowrap;
  }
  .wordmark:hover {
    text-decoration: underline;
    text-decoration-color: var(--faint);
  }
</style>
