---
// Global header (SPEC §7.1): wordmark, search field, quiet section links.
import HeaderSearch from "./HeaderSearch.astro";
import { es } from "../i18n/es.ts";
import { loadEdition } from "../lib/edition.ts";

const { authors } = await loadEdition();
const path = Astro.url.pathname;
---

<header class="site indented">
  <a class="wordmark" href="/">
    {es.site.name}
  </a>
  <HeaderSearch />
  <nav aria-label={es.nav.label}>
    {authors.map((a) => (
      <a
        href={`/${a.id}`}
        aria-current={path === `/${a.id}` ? "page" : undefined}
      >
        {a.name}
      </a>
    ))}
    <!-- Target of «Índices» is not in the spec. PROPOSED: the title index. -->
    <a
      href="/indice/titulos"
      aria-current={path.startsWith("/indice/") ? "page" : undefined}
    >
      {es.nav.indices}
    </a>
  </nav>
</header>

<style>
  header.site {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding-top: var(--s-5);
  }
  .wordmark {
    font-size: 0.92rem;
    font-weight: 500;
    font-variant: small-caps;
    letter-spacing: 0.09em;
    text-decoration: none;
    white-space: nowrap;
  }
  .wordmark:hover {
    text-decoration: underline;
    text-decoration-color: var(--faint);
  }
  nav {
    display: flex;
    gap: var(--s-4);
    margin-left: auto;
    font-size: var(--fs-ui);
    color: var(--muted);
    white-space: nowrap;
  }
  nav a {
    text-decoration: none;
    transition: color var(--t);
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
  }
  @media (max-width: 640px) {
    header.site {
      flex-wrap: wrap;
      gap: var(--s-2) var(--s-3);
      padding-left: 0;
    }
    nav {
      margin-left: 0;
      gap: var(--s-3);
      font-size: var(--fs-sm);
    }
  }
</style>
