---
// Series mark (SPEC §8.1, §11): a bordered square with the position number
// beside the collection or tag name, linking to its page.
interface Props {
  href: string;
  title: string;
  position?: number | undefined;
  small?: boolean;
}
const { href, title, position, small = false } = Astro.props;
---

<a class:list={["mark", { small }]} href={href}>
  {position !== undefined && <span class="num">{position}</span>}
  {title}
</a>

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-size: 0.86rem;
    color: var(--muted);
    text-decoration: none;
    padding: 0.28em 0.75em 0.28em 0.28em;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    transition:
      color var(--t),
      border-color var(--t);
  }
  .mark:not(:has(.num)) {
    padding-left: 0.75em;
  }
  .mark:hover {
    color: var(--ink);
    border-color: var(--faint);
  }
  .num {
    display: grid;
    place-items: center;
    min-width: 1.5em;
    height: 1.5em;
    border: 1px solid var(--line);
    border-radius: var(--r-xs);
    font-size: 0.92em;
    font-feature-settings: "tnum" 1;
    color: var(--ink);
    transition: border-color var(--t);
  }
  .mark:hover .num {
    border-color: var(--faint);
  }
  .small {
    font-size: var(--fs-sm);
    padding: 0.12em 0.55em 0.12em 0.12em;
  }
</style>
