---
// Site footer: only on the home and about pages.
import { es } from "../i18n/es.ts";
import { REPO_URL } from "../site.config.ts";

interface Props {
  wide?: boolean;
}
const { wide = false } = Astro.props;
const links = [
  ["/descargas", es.footer.downloads],
  ["/rss.xml", es.footer.rss],
] as const;
---

<footer class:list={["foot", { wide }]}>
  <div>
    <p class="name">{es.site.name}</p>
    <p class="line">{es.footer.line}</p>
    <a class="code" href={REPO_URL}>
      <svg
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
      </svg>
      {es.footer.code}
    </a>
  </div>
  <nav aria-label={es.footer.label}>
    <ul>
      {links.map(([href, label]) => (
        <li>
          <a href={href}>{label}</a>
        </li>
      ))}
    </ul>
  </nav>
</footer>

<style>
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-8) var(--s-16);
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--s-10) var(--page-pad) var(--s-12)
      calc(var(--page-pad) + var(--indent));
    border-top: 1px solid var(--line);
  }
  .foot.wide {
    max-width: var(--page-max-wide);
    padding-inline: var(--page-pad-wide);
  }
  .name {
    margin: 0;
    font-weight: 600;
  }
  .line {
    margin: var(--s-1) 0 var(--s-5);
    max-width: 34rem;
    font-size: var(--fs-body-sm);
    color: var(--muted);
  }
  .code {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.5em 1.05em;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    font-size: var(--fs-body-sm);
    color: var(--muted);
    text-decoration: none;
    transition:
      color var(--t),
      border-color var(--t),
      background var(--t);
  }
  .code:hover {
    color: var(--ink);
    border-color: var(--muted);
    background: var(--raise);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ul a {
    font-size: var(--fs-body-sm);
    color: var(--muted);
    text-decoration: none;
    transition: color var(--t);
  }
  ul a:hover {
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .foot {
      gap: var(--s-6);
      padding-block: var(--s-8) var(--s-10);
    }
  }
</style>
