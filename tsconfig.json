// Type-checks the Node scripts and the pure modules they import. Everything
// under site/ is checked by `astro check` with site/tsconfig.json.
{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "vitest.config.ts"]
}
