// Pure lib modules are also checked here; edition.ts needs astro:content and is
// checked by astro check instead.
{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "site/src/lib/**/*.ts", "vitest.config.ts"],
  "exclude": ["site/src/lib/edition.ts"]
}
