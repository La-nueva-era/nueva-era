{
  "name": "nueva-era",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev --root site",
    "build": "astro build --root site",
    "preview": "astro preview --root site",
    "lint": "eslint . && prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path \"$(git rev-parse --git-path info/exclude)\"",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path \"$(git rev-parse --git-path info/exclude)\"",
    "lint:content": "tsx scripts/lint-content.ts",
    "typecheck": "astro check --root site && tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/literata": "^5.3.0",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
